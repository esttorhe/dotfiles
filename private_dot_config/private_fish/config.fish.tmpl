# ABOUTME: Fish shell configuration - minimal entry point
# ABOUTME: Environment, PATH, abbreviations loaded from conf.d/; functions from functions/

# Only run in interactive mode
status is-interactive; or exit

# Disable greeting
set fish_greeting ""

# ============================================
# Tool integrations
# ============================================

# Mise version manager. Activated first so the tools it installs (atuin among
# them) are on PATH for the integrations below, even in shells that start with
# only the system PATH, such as Rex panes.
if type -q mise
    mise activate fish | source
end

# Starship prompt
starship init fish | source

# Atuin shell history
if type -q atuin
    # Atuin's output capture re-execs an interactive shell under its pty-proxy,
    # which drops a `fish -c COMMAND` (rex-opener's picker runs `fish -lic`).
    # atuin skips the proxy when ATUIN_PTY_PROXY_FAILED is set, as its zsh and
    # bash init already do for -c shells (atuinsh/atuin#4412).
    for arg in (string split ' ' -- (ps -o args= -p $fish_pid))[2..]
        string match -qr -- '^-' $arg; or break
        if string match -qr -- '^(-[a-zA-Z]*c[a-zA-Z]*|--command(=.*)?)$' $arg
            set -g ATUIN_PTY_PROXY_FAILED 1
            break
        end
    end
    atuin init fish | source
end

# fzf keybindings
if type -q fzf
    fzf --fish | source
end

# direnv
if type -q direnv
    direnv hook fish | source
end

# zoxide
if type -q zoxide
    zoxide init fish | source
end

# msgvault
if type -q msgvault
    msgvault completion fish | source
end

# spf cd on quit, from https://superfile.dev/configure/superfile-config/
function spf
    set os $(uname -s)

    if test "$os" = Linux
        set spf_last_dir "$HOME/.local/state/superfile/lastdir"
    end

    if test "$os" = Darwin
        set spf_last_dir "$HOME/Library/Application Support/superfile/lastdir"
    end

    command spf $argv

    if test -f "$spf_last_dir"
        source "$spf_last_dir"
        rm -f -- "$spf_last_dir" >>/dev/null
    end
end

# ============================================
# Completions
# ============================================

# Bun completions
if test -f "$BUN_INSTALL/_bun"
    source "$BUN_INSTALL/_bun"
end

# ============================================
# Shell startup
# ============================================

# Fortune/habits reminder on shell start
if type -q fortune; and test -d "$HOME/.local/habits"
    fortune "$HOME/.local/habits"
    echo
end

