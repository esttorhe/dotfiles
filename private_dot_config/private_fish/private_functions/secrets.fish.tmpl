# ABOUTME: Load 1Password secrets into the current shell on demand: secrets [typesafe|litellm|github ...]
# ABOUTME: Secrets never land on disk; values live only in the shell env, and only once asked for

# Shells don't read secrets at startup: 1Password asks for Touch ID once per terminal
# session, so a startup lookup prompted in every new pane. Tools that need a secret
# load it here (omp does so itself); run `secrets` by hand for anything else.

# Item UUIDs used instead of titles: titles can contain characters op rejects in secret refs

function secrets --description "Load 1Password secrets into this shell: typesafe, litellm, github (default: all)"
    set -l names $argv
    test (count $names) -eq 0; and set names typesafe litellm github
    set -l failed 0
    for name in $names
        switch $name
            case typesafe
                # TypeSafe AI – API Key (Private vault, personal account). Read by the TypeSafe
                # SDK for the Jev model. The account is spelled as a URL because `op` does not
                # resolve this account by email; the title cannot appear in the reference at all,
                # as it contains an en dash that op rejects.
                __op_secret TYPESAFE_API_KEY my.1password.eu 'op://Private/6tw3agthzbudgbrykz3tuyqy3i/credential'; or set failed 1
            case litellm
                # LiteLLM virtual key (Private vault, personal account), scoped to a single
                # model. omp discovers models through its built-in litellm provider using this
                # key plus LITELLM_BASE_URL. The endpoint is deliberately NOT named here: this
                # repository is public, and an internal service hostname is not something to
                # publish. It comes from the local chezmoi config, which is never committed.
                # Account spelled as a URL for the same reason as above.
                #
                # Note: omp persists this key into its own credential vault
                # (~/.omp/agent/agent.db, table auth_credentials) on first use, and the stored
                # copy WINS over this environment variable. After rotating the key, clear the
                # stored row and omp's cached catalogue or omp keeps serving the old models:
                #   sqlite3 ~/.omp/agent/agent.db "DELETE FROM auth_credentials WHERE provider='litellm';"
                #   sqlite3 ~/.omp/agent/models.db "DELETE FROM model_cache WHERE provider_id LIKE '%litellm%';"
                __op_secret LITELLM_API_KEY my.1password.eu 'op://Private/7f4rs23l5cnvhiili6ckiakmku/password'; or set failed 1
            case github
                # FitForge - GITHUB TOKEN (Engineering vault, pixeltowers account). Inside tmux
                # the server fetches and propagates it via update-environment, so this is a
                # no-op there.
                __op_secret GITHUB_TOKEN {{ .op_account_work }} 'op://Engineering/kyl6ugf3ylddze7zc5akxfgzxm/token'; or set failed 1
            case '*'
                echo "secrets: unknown secret '$name' (known: typesafe, litellm, github)" >&2
                set failed 1
        end
    end
    return $failed
end
