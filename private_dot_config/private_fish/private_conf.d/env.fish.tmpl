# ABOUTME: Environment variables for fish shell
# ABOUTME: Sourced automatically by fish from conf.d/

# Core environment
set -gx EDITOR nvim
set -gx VISUAL nvim
set -gx LANG en_US.UTF-8
set -gx LC_ALL en_US.UTF-8
set -gx TERM xterm-256color

# Go configuration
set -gx GOPATH ~/workspace
set -gx GO111MODULE on

# Docker settings
set -gx CRUN_NFS 1
set -gx DOCKER_ENABLE_DEPRECATED_PULL_SCHEMA_1_IMAGE true

# Tool configurations
set -gx RIPGREP_CONFIG_PATH "$HOME/.config/ripgreprc"
set -gx GPG_TTY (tty)

# Pulumi reads this even when empty, which answers the passphrase prompt with a
# blank entry instead of blocking on it.
set -gx PULUMI_CONFIG_PASSPHRASE ""

# Homebrew (macOS only)
{{ if eq .chezmoi.os "darwin" -}}
set -gx HOMEBREW_EDITOR nvim
set -gx HOMEBREW_CASK_OPTS "--appdir=/Applications"
{{- end }}

# pyenv
set -gx PYENV_ROOT "$HOME/.pyenv"

# Android SDK (macOS only)
{{ if eq .chezmoi.os "darwin" -}}
set -gx ANDROID_HOME "$HOME/Library/Android/sdk"
{{- end }}

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
set -gx PNPM_HOME "$HOME/Library/pnpm"
{{ else -}}
set -gx PNPM_HOME "$HOME/.local/share/pnpm"
{{- end }}

# bun
set -gx BUN_INSTALL "$HOME/.bun"

# NVM
set -gx NVM_DIR "$HOME/.nvm"

# SDKMAN
set -gx SDKMAN_DIR "$HOME/.sdkman"

# LiteLLM proxy fronting Gemini for omp. The key lives in secrets-lazy.fish.
# The endpoint is held in the local chezmoi config rather than written here:
# this repo is public, and an internal hostname is infrastructure disclosure
# even though it is not a credential. omp would otherwise default to
# http://localhost:4000/v1, which is wrong — the instance is remote.
set -gx LITELLM_BASE_URL {{ .litellm_base_url | quote }}
