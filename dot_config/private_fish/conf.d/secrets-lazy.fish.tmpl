# ABOUTME: Lazy 1Password secret lookups - runs `op read` at interactive shell startup
# ABOUTME: Secrets never land on disk; values live only in the shell env

status is-interactive; or return
type -q op; or return

# Item UUIDs used instead of titles: titles can contain characters op rejects in secret refs

# Each secret guards itself rather than sharing one early return, so a value
# already in the environment skips only its own lookup. Skipping is what keeps
# tmux child shells from re-prompting Touch ID for something already propagated.

# TypeSafe AI – API Key (Private vault, personal account). Read by the TypeSafe
# SDK for the Jev model. The account is spelled as a URL because `op` does not
# resolve this account by email; the title cannot appear in the reference at all,
# as it contains an en dash that op rejects.
if not set -q TYPESAFE_API_KEY
    set -l _ts_key (op read --account my.1password.eu 'op://Private/6tw3agthzbudgbrykz3tuyqy3i/credential' 2>/dev/null)
    if test -n "$_ts_key"
        set -gx TYPESAFE_API_KEY "$_ts_key"
    end
    set -e _ts_key
end

# LiteLLM virtual key (Private vault, personal account), scoped to a single
# model. omp discovers models through its built-in litellm provider using this
# key plus LITELLM_BASE_URL. The endpoint is deliberately NOT named here: this
# repository is public, and an internal service hostname is not something to
# publish. It comes from the local chezmoi config, which is never committed.
# Account spelled as a URL for the same reason as above.
#
# Note: omp persists this key into its own credential vault
# (~/.omp/agent/agent.db, table auth_credentials) on first use, and the stored
# copy WINS over this environment variable. After rotating the key, clear the
# stored row and omp's cached catalogue or omp keeps serving the old models:
#   sqlite3 ~/.omp/agent/agent.db "DELETE FROM auth_credentials WHERE provider='litellm';"
#   sqlite3 ~/.omp/agent/models.db "DELETE FROM model_cache WHERE provider_id LIKE '%litellm%';"
if not set -q LITELLM_API_KEY
    set -l _litellm_key (op read --account my.1password.eu 'op://Private/7f4rs23l5cnvhiili6ckiakmku/password' 2>/dev/null)
    if test -n "$_litellm_key"
        set -gx LITELLM_API_KEY "$_litellm_key"
    end
    set -e _litellm_key
end

# Skip when already populated — inside tmux the server fetches and propagates
# via update-environment, so child shells must not re-prompt Touch ID.
set -q GITHUB_TOKEN; and return

# FitForge - GITHUB TOKEN (Engineering vault, pixeltowers account)
set -l _gh_token (op read --account {{ .op_account_work }} 'op://Engineering/kyl6ugf3ylddze7zc5akxfgzxm/token' 2>/dev/null)
if test -n "$_gh_token"
    set -gx GITHUB_TOKEN "$_gh_token"
end
set -e _gh_token

