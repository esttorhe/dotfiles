{{- $email := promptStringOnce . "email" "GitHub email address" -}}
{{- $pixeltowersEmail := promptStringOnce . "pixeltowers_email" "Pixeltowers email address" -}}
{{- $opPersonal := promptStringOnce . "op_account_personal" "1Password personal account sign-in address" -}}
{{- $opWork := promptStringOnce . "op_account_work" "1Password work account sign-in address" -}}

encryption = "age"

[data]
    email = {{ $email | quote }}
    pixeltowers_email = {{ $pixeltowersEmail | quote }}
    op_account_personal = {{ $opPersonal | quote }}
    op_account_work = {{ $opWork | quote }}

[onepassword]
    prompt = false

[diff]
    pager = "diff-so-fancy"

[merge]
    command = "bash"
    args = [
        "-c",
        '''
set -eu
destination=$1 target=$2 source=$3
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# Merge into a scratch file so an abandoned merge cannot clobber the source.
# Naming it after the source (minus .tmpl) gives VS Code the right syntax mode.
merged="$tmpdir/$(basename "${source%.tmpl}")"
: > "$merged"

# path1 = the live file, path2 = the source (template markup lives here),
# base = the rendered target, which is the common ancestor of both. VS Code
# then replays the destination's edits onto the template instead of over it.
code --new-window --wait --merge "$destination" "$source" "$target" "$merged"

if [ ! -s "$merged" ]; then
    echo "chezmoi merge: nothing saved, left $source unchanged" >&2
elif grep -q '^<<<<<<< ' "$merged"; then
    echo "chezmoi merge: unresolved conflict markers, left $source unchanged" >&2
    exit 1
else
    cp "$merged" "$source"
fi
''',
        "chezmoi-merge",
        {{ `"{{ .Destination }}"` }},
        {{ `"{{ .Target }}"` }},
        {{ `"{{ .Source }}"` }},
    ]

[age]
    identity = "~/.config/age/key.txt"
    recipient = "age19c2gfd538whr4jnh44h9f6k5q83xw2l925nuj6gc2k97cnzqqv5qtclajq"
